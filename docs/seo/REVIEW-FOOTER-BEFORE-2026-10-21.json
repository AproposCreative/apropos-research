  "content": "<template data-apropos-book-metadata>\n  <span data-book-title>{{wf {&quot;path&quot;:&quot;book-title&quot;,&quot;type&quot;:&quot;PlainText&quot;\\} }}</span>\n  <span data-book-author>{{wf {&quot;path&quot;:&quot;book-author&quot;,&quot;type&quot;:&quot;PlainText&quot;\\} }}</span>\n</template>\n<script>\n// Strip only explicit review-title wrappers. Do not invent a work title from\n// prose, or use this fallback in place of the dedicated book metadata below.\nfunction aproposReviewedWorkName(headline) {\n  var original = String(headline || '').trim();\n  var name = original\n    .replace(/^(?:anmeldelse|filmanmeldelse|serieanmeldelse|spilanmeldelse|albumanmeldelse|review|film review|game review|album review)\\s*[:\\u2013\\u2014-]\\s*/i, '')\n    .replace(/\\s+(?:[\\u2013\\u2014-]\\s*)?(?:anmeldelse|review)\\s*$/i, '').trim();\n  return name || original;\n}\n\n// Book metadata is distinct from Article.author (the reviewer).\n// Read plain text from inert HTML, never interpolate book titles into JavaScript strings.\nfunction aproposReviewedBook(article) {\n  var metadata = document.querySelector('template[data-apropos-book-metadata]');\n  function field(selector) {\n    var element = metadata && metadata.content && metadata.content.querySelector(selector);\n    var value = element ? element.textContent.trim() : '';\n    return /\\{\\{\\s*wf\\b/i.test(value) ? '' : value;\n  }\n  var title = field('[data-book-title]');\n  var headline = String(article.headline || '').trim();\n  var prefix = /^(?:boganmeldelse|book[ -]review)\\s*[:\\u2013\\u2014-]\\s*/i;\n  if (!title && !prefix.test(headline)) return null;\n  var name = title || headline.replace(prefix, '').trim();\n  if (!name) return null;\n  var book = { '@type': 'Book', name: name };\n  if (article.image) book.image = article.image;\n  var authors = field('[data-book-author]').split(';').map(function (name) {\n    return name.trim();\n  }).filter(Boolean).map(function (name) {\n    return { '@type': 'Person', name: name };\n  });\n  if (authors.length) book.author = authors.length === 1 ? authors[0] : authors;\n  return book;\n}\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  const rating = Number('{{wf {&quot;path&quot;:&quot;stjerne&quot;,&quot;type&quot;:&quot;Number&quot;\\} }}');\n  if (!Number.isFinite(rating) || rating < 1 || rating > 6) return;\n  if (document.querySelector('script[data-apropos-review-schema]')) return;\n\n  const schemas = [...document.querySelectorAll('script[type=\"application/ld+json\"]')]\n    .map((node) => { try { return JSON.parse(node.textContent || ''); } catch { return null; } })\n    .filter(Boolean);\n  const article = schemas.find((schema) => schema['@type'] === 'Article') ||\n    schemas.flatMap((schema) => schema['@graph'] || []).find((schema) => schema['@type'] === 'Article');\n  if (!article) return;\n\n  const book = aproposReviewedBook(article);\n  const subject = `${article.articleSection || ''} ${article.keywords || ''}`.toLowerCase();\n  const label = document.querySelector('.apropos-review-label');\n  if (label) {\n    label.textContent = book ? 'Boganmeldelse' : subject.includes('film') ? 'Filmanmeldelse' :\n      subject.includes('serie') || subject.includes('tv') ? 'Serieanmeldelse' :\n      subject.includes('koncert') ? 'Koncertanmeldelse' :\n      subject.includes('festival') ? 'Festivalanmeldelse' :\n      subject.includes('album') || subject.includes('musik') ? 'Musikanmeldelse' :\n      subject.includes('gaming') || subject.includes('spil') ? 'Spilanmeldelse' :\n      subject.includes('teater') ? 'Teateranmeldelse' : 'Anmeldelse';\n    label.classList.add('is-visible');\n  }\n\n  const reviewedType = book ? 'Book' : subject.includes('film') ? 'Movie' :\n    subject.includes('serie') || subject.includes('tv') ? 'TVSeries' :\n    subject.includes('gaming') || subject.includes('spil') ? 'VideoGame' :\n    subject.includes('album') || subject.includes('musik') ? 'MusicAlbum' : 'CreativeWork';\n  const canonical = document.querySelector('link[rel=\"canonical\"]')?.href || article.url || location.href;\n  const review = {\n    '@context': 'https://schema.org',\n    '@type': 'Review',\n    '@id': `${canonical}#review`,\n    url: canonical,\n    name: article.headline,\n    reviewBody: article.description,\n    inLanguage: article.inLanguage || 'da',\n    datePublished: article.datePublished,\n    dateModified: article.dateModified,\n    author: article.author ? {\n      '@type': article.author['@type'] || 'Person',\n      name: article.author.name,\n      url: article.author.url\n    } : undefined,\n    publisher: article.publisher,\n    reviewRating: {\n      '@type': 'Rating',\n      ratingValue: rating,\n      bestRating: 6,\n      worstRating: 1\n    },\n    itemReviewed: book || {\n      '@type': reviewedType,\n      name: aproposReviewedWorkName(article.headline),\n      image: article.image\n    }\n  };\n  const node = document.createElement('script');\n  node.type = 'application/ld+json';\n  node.dataset.aproposReviewSchema = '';\n  node.textContent = JSON.stringify(review);\n  document.head.appendChild(node);\n});\n\ndocument.addEventListener('DOMContentLoaded', function () {\n  setTimeout(function () {\n    var lang = (document.documentElement.lang || 'da').split('-')[0];\n    var url = 'https://www.aproposmagazine.com' + location.pathname.replace(/\\/+$/, '');\n    var canonical = document.querySelector('link[rel=\"canonical\"]');\n    if (canonical) canonical.href = url;\n    var articleEntry = null;\n    var reviewEntry = null;\n    document.querySelectorAll('script[type=\"application/ld+json\"]').forEach(function (node) {\n      try {\n        var root = JSON.parse(node.textContent || '');\n        var items = root['@graph'] || [root];\n        var article = items.find(function (item) { return item['@type'] === 'Article'; });\n        var review = items.find(function (item) { return item['@type'] === 'Review'; });\n        if (article) articleEntry = { node: node, root: root, data: article };\n        if (review) reviewEntry = { node: node, root: root, data: review };\n      } catch (error) {}\n    });\n    if (articleEntry) {\n      articleEntry.data.url = url;\n      articleEntry.data.inLanguage = lang;\n      articleEntry.node.textContent = JSON.stringify(articleEntry.root);\n    }\n    var label = document.querySelector('.apropos-review-label');\n    if (!reviewEntry || !articleEntry) {\n      if (label) label.style.display = 'none';\n      return;\n    }\n    var article = articleEntry.data;\n    var review = reviewEntry.data;\n    var book = aproposReviewedBook(article);\n    var headline = String(article.headline || '').toLowerCase();\n    var description = String(article.description || '').toLowerCase();\n    var keywords = String(article.keywords || '').toLowerCase();\n    var section = String(article.articleSection || '').toLowerCase();\n    var coreText = [headline, description, keywords, section].join(' ');\n    var count = function (text, expression) { return (text.match(expression) || []).length; };\n    var seriesPattern = /\\b(tv[- ]?serie(?:n|r|rne)?|serie(?:n|r|rne)?|series|sæson(?:en|er|erne)?|season(?:s)?|episode(?:n|r|rne|s)?)\\b/g;\n    var moviePattern = /\\b(film(?:en|er|ene|s)?|movie(?:s)?|biograf(?:en|er|erne)?|cinema)\\b/g;\n    var seriesScore = count(headline, seriesPattern) * 6 + count(description, seriesPattern) * 3 + count(keywords, seriesPattern) * 10;\n    var movieScore = count(headline, moviePattern) * 6 + count(description, moviePattern) * 3 + count(keywords, moviePattern) * 10;\n    var sectionSeries = count(section, seriesPattern) > 0;\n    var sectionMovie = count(section, moviePattern) > 0;\n    if (sectionSeries && !sectionMovie) seriesScore += 4;\n    if (sectionMovie && !sectionSeries) movieScore += 4;\n    var eventKind = /festival/.test(coreText) ? 'festival' : /koncert|concert|\\blive\\b/.test(coreText) ? 'concert' : /teater|theatre|theater/.test(coreText) ? 'theatre' : 'event';\n    var isGame = /\\b(gaming|videospil|spilanmeldelse|game review|video game|playstation|ps[45]|xbox|nintendo|switch)\\b/.test(coreText);\n    var isAlbum = /\\b(album(?:met|mer)?|ep(?:'en)?|single(?:n|s)?|plade(?:n|r)?|record)\\b/.test(coreText);\n    var isEventReview = !book && eventKind !== 'event' && !isGame && seriesScore === 0 && movieScore === 0 && !isAlbum;\n    var type = review.itemReviewed && review.itemReviewed['@type'];\n    if (book) type = 'Book';\n    else if (isEventReview) type = 'CreativeWork';\n    else if (isGame) type = 'VideoGame';\n    else if (seriesScore > movieScore) type = 'TVSeries';\n    else if (movieScore > seriesScore) type = 'Movie';\n    else if (isAlbum) type = 'MusicAlbum';\n    if (book) review.itemReviewed = book;\n    else if (review.itemReviewed) review.itemReviewed.name = aproposReviewedWorkName(article.headline);\n    if (review.itemReviewed && type) review.itemReviewed['@type'] = type;\n    review.url = url;\n    review['@id'] = url + '#review';\n    review.inLanguage = lang;\n    review.name = article.headline;\n    reviewEntry.node.textContent = JSON.stringify(reviewEntry.root);\n    var labelsDa = { Book: 'Boganmeldelse', Movie: 'Filmanmeldelse', TVSeries: 'Serieanmeldelse', VideoGame: 'Spilanmeldelse', MusicAlbum: 'Musikanmeldelse', CreativeWork: 'Anmeldelse' };\n    var labelsEn = { Book: 'Book review', Movie: 'Film review', TVSeries: 'Series review', VideoGame: 'Game review', MusicAlbum: 'Music review', CreativeWork: 'Review' };\n    var eventLabelsDa = { festival: 'Festivalanmeldelse', concert: 'Koncertanmeldelse', theatre: 'Teateranmeldelse', event: 'Eventanmeldelse' };\n    var eventLabelsEn = { festival: 'Festival review', concert: 'Concert review', theatre: 'Theatre review', event: 'Event review' };\n    var labelText = isEventReview ? (lang === 'en' ? eventLabelsEn : eventLabelsDa)[eventKind] : (lang === 'en' ? labelsEn : labelsDa)[type];\n    if (isEventReview) reviewEntry.node.remove();\n    if (label) {\n      label.style.display = '';\n      label.textContent = labelText || (lang === 'en' ? 'Review' : 'Anmeldelse');\n    }\n  }, 0);\n});\n</script>\n",
  "scope": "Articles Template freeform footer before taxonomy-based Review repair"
}
