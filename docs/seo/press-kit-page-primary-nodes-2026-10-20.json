      "text": {
        "html": "<h3 class=\"press-case-title\"><a class=\"press-title-link\" href=\"https://www.aproposmagazine.com/articles/farveblind-lille-vega-anmeldelse-2026\" data-w-id=\"93cff143-c674-9c0b-d261-d04567d00941\">Farveblind i Lille VEGA</a></h3>",
