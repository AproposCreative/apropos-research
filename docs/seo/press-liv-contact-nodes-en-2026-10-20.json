    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d00910",
      "text": {
        "html": "<h2 id=\"press-coverage-heading\" class=\"press-section-title-1\">The works. The experiences. The conversations around them.</h2>",
        "text": "The works. The experiences. The conversations around them."
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d00912",
      "text": {
        "html": "<p class=\"press-paragraph-1\">Apropos covers culture through reviews, essays, guides and commentary. Its focus is on the works, their expression and the questions they open up: from the form and energy of a concert to a novel's view of society or the way a game tells a story.</p>",
        "text": "Apropos covers culture through reviews, essays, guides and commentary. Its focus is on the works, their expression and the questions they open up: from the form and energy of a concert to a novel's view of society or the way a game tells a story."
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d00915",
      "text": {
        "html": "<h3 class=\"press-subtitle\"><a href=\"https://www.aproposmagazine.com/sections/musik\" class=\"press-title-link\" data-w-id=\"3485cc97-a8e5-0936-9c6f-0e74ce8bd168\">Music</a></h3>",
        "text": "Music"
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d00917",
      "text": {
        "html": "<p class=\"press-area-text\">Concert reviews, festival coverage, album reviews and guides to acts on the programme. With room for both the music and the culture around the stages.</p>",
        "text": "Concert reviews, festival coverage, album reviews and guides to acts on the programme. With room for both the music and the culture around the stages."
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d0091b",
      "text": {
        "html": "<h3 class=\"press-subtitle\"><a href=\"https://www.aproposmagazine.com/sections/serierogfilm\" class=\"press-title-link\" data-w-id=\"82d7de1b-bd8c-4f85-8589-36c21d9c997b\">Film and television</a></h3>",
