      "text": {
        "html": "<h3 class=\"press-subtitle\"><a href=\"https://www.aproposmagazine.com/sections/kultur\" class=\"press-title-link\" data-w-id=\"63bed568-78cc-5238-c53f-609ae1d05187\">Books</a></h3>",
