      "text": {
        "html": "<h3 class=\"press-subtitle\"><a href=\"https://www.aproposmagazine.com/sections/kultur\" class=\"press-title-link\" data-w-id=\"7022e9c2-f90d-acc9-6c52-60aebff1a7d0\">Art and design</a></h3>",
