    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d008f2",
      "text": {
        "html": "<h3 class=\"press-subtitle\">Short description · 50 words</h3>",
        "text": "Short description · 50 words"
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d008f4",
      "text": {
        "html": "<p class=\"press-copy-text\">Apropos Magazine explores the culture we listen to, watch, read and play. The independent Danish digital culture publication covers music, film, television, books, art, gaming and cultural life through reviews, essays and commentary. Free to read, it carries no advertisements, native advertising or sponsored editorial content. Publisher: Apropos Creative ApS.</p>",
        "text": "Apropos Magazine explores the culture we listen to, watch, read and play. The independent Danish digital culture publication covers music, film, television, books, art, gaming and cultural life through reviews, essays and commentary. Free to read, it carries no advertisements, native advertising or sponsored editorial content. Publisher: Apropos Creative ApS."
      },
      "attributes": {}
    },
    {
      "type": "text",
      "id": "93cff143-c674-9c0b-d261-d04567d008f7",
      "text": {
