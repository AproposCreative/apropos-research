{
  "$id": "EditorialAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "articleType",
    "topic",
    "angleOrThesis",
    "primaryEntity",
    "secondaryEntities",
    "stanceOrVerdict",
    "audiences",
    "searchIntent",
    "freshness",
    "spoilerSensitive",
    "facts",
    "opportunities"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "articleType": {
      "type": "object",
      "required": ["suggested", "conflict", "confidence", "reason"],
      "properties": {
        "editor": { "type": "string" },
        "suggested": { "type": "string" },
        "conflict": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    },
    "topic": { "$ref": "#/$defs/judgementString" },
    "angleOrThesis": { "$ref": "#/$defs/judgementString" },
    "primaryEntity": {
      "type": "object",
      "required": ["asWritten", "entityType", "evidence", "confidence"],
      "properties": {
        "asWritten": { "type": "string" },
        "likelyOfficialName": { "type": "string" },
        "entityType": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "secondaryEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "entityType", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "entityType": { "type": "string" },
          "relation": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "work": { "type": "string" },
    "artist": {
      "type": "string",
      "description": "Subject artist/band/performer — never the article author"
    },
    "platform": { "type": "string" },
    "festival": { "type": "string" },
    "venue": { "type": "string" },
    "city": { "type": "string" },
    "stanceOrVerdict": { "$ref": "#/$defs/judgementString" },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "searchIntent": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["evergreen", "timely", "dateSensitive"],
      "properties": {
        "evergreen": { "type": "boolean" },
        "timely": { "type": "boolean" },
        "dateSensitive": { "type": "boolean" }
      }
    },
    "spoilerSensitive": { "type": "boolean" },
    "facts": {
      "type": "object",
      "required": ["verified", "articleClaims", "inferred", "mustNotAmplify", "missing"],
      "properties": {
        "verified": { "type": "array", "items": { "type": "string" } },
        "articleClaims": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } },
        "mustNotAmplify": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opportunities": {
      "type": "object",
      "required": ["entityLed", "intentLed", "angleLed", "timely", "evergreen"],
      "properties": {
        "entityLed": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
        "intentLed": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
        "angleLed": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
        "timely": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
        "evergreen": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["quote", "startOffset", "endOffset", "quoteHash", "articleVersionHash"],
      "properties": {
        "quote": { "type": "string", "maxLength": 180 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "quoteHash": { "type": "string" },
        "articleVersionHash": { "type": "string" }
      }
    },
    "judgementString": {
      "type": "object",
      "required": ["value", "confidence", "reason", "factLevel"],
      "properties": {
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" },
        "factLevel": { "type": "string", "enum": ["verified", "article_claim", "inferred"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "opportunity": {
      "type": "object",
      "required": ["label", "kind", "confidence", "reason"],
      "properties": {
        "label": { "type": "string" },
        "kind": { "type": "string", "const": "heuristic_editorial_opportunity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    }
  }
}
