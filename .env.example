# Core
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=
# Lokal: `npm run dev` → http://localhost:3000. Valgfri TLS: `npm run dev:https` → https://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase (server/admin)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_STORAGE_BUCKET=
FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_STORAGE_BUCKET=

# Webflow
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_AUTHORS_COLLECTION_ID=
WEBFLOW_ARTICLES_COLLECTION_ID=
WEBFLOW_SECTIONS_COLLECTION_ID=
WEBFLOW_TOPICS_COLLECTION_ID=
WEBFLOW_FESTIVALS_COLLECTION_ID=
WEBFLOW_STREAMING_SERVICES_COLLECTION_ID=
# Auto-billedoptimering ved publish (app) + Webflow webhook — slået til som standard.
# WEBFLOW_AUTO_IMAGE_OPTIMIZE=1
# Desktop/thumb: PNG/JPEG → WebP, samme opløsning, mindre filstørrelse.
# WEBFLOW_AUTO_THUMB_IMAGE_OPTIMIZE=1
# WEBFLOW_THUMB_IMAGE_MAX_KB=600
# WEBFLOW_THUMB_IMAGE_MIN_KB=120
# Mobile Image auto-optimering: slået til som standard. Sæt til 0/false for at stoppe auto-variant ved nye Webflow-artikler.
# WEBFLOW_MOBILE_IMAGE_OPTIMIZE=1
# Target til Webflow-feltet "Mobile Image".
# WEBFLOW_MOBILE_IMAGE_MAX_KB=260
# WEBFLOW_MOBILE_IMAGE_MAX_EDGE=1200
# Batch-optimering (Indstillinger → Integrationer → Optimering) uploader WebP til Firebase Storage.
# Kræver FIREBASE_ADMIN_* og FIREBASE_STORAGE_BUCKET (eller NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET).
# Brødtekst-billeder: /api/webflow/content-image/* — erstatter <img> i CMS-feltet "content".
# WEBFLOW_AUTO_CONTENT_IMAGE_OPTIMIZE=1
# WEBFLOW_CONTENT_IMAGE_MAX_KB=200
# WEBFLOW_CONTENT_IMAGE_MAX_EDGE=1200
# Auto ved publish fra app + Webflow CMS-webhook:
# POST /api/webhooks/webflow — trigger collection_item_published (anbefalet) eller collection_item_created
# WEBFLOW_WEBHOOK_CLIENT_SECRET=  (fra Webflow Data Client — til x-webflow-signature)
# WEBFLOW_WEBHOOK_SECRET=         (valgfri fallback: ?secret= på webhook-URL)
# WEBFLOW_ARTICLE_WEBHOOK_OPTIMIZE=true
# Opret webhook: npx tsx scripts/setup-webflow-article-webhook.ts
# Auto-SEO Engine (tomme seo-title / meta-description ved DK-publish). Default OFF.
# WEBFLOW_AUTO_SEO_ENGINE=false
# GSC/GA4 automatic SEO drift (production default ON when unset).
# Kun sikre felter: seo-title / meta-description (+ server JSON-LD snapshot).
# Sæt false for nød-stop uden Firestore UI:
# SEO_ENGINE_AUTO_OPPORTUNITY_OPT=false
# Cron: GET /api/cron/seo-engine-opportunities/daily (collect) | /weekly (optimize, max 10)
# Docs: docs/seo-engine-opportunity-engine.md
#
# Prod allowlist (fail-closed hvis BEGGE er tomme i production):
#   medlemskab i SEO_ENGINE_ALLOWED_UIDS ELLER SEO_ENGINE_ADMIN_UIDS
# SEO_ENGINE_ADMIN_UIDS=uid1,uid2
# SEO_ENGINE_ALLOWED_UIDS=
#
# Ephemeral lokal demo — kræver BEGGE flag + non-prod + header x-seo-engine-ephemeral-demo: 1
# Sæt ALDRIG i production:
# SEO_ENGINE_DEMO=true
# NEXT_PUBLIC_SEO_ENGINE_DEMO=true
#
# SEO_ENGINE_OPENAI_TIMEOUT_MS=60000
# SEO_ENGINE_OPENAI_MAX_TOKENS=4000
# CMS-locales (defaults i lib/config/env.ts hvis unset):
# WEBFLOW_CMS_LOCALE_DK=67dbf17ba540975b5b21c225
# WEBFLOW_CMS_LOCALE_EN=690ca0f6b0d13d8788354156
# Overlay: /ai?view=seo
# Recovery cron: GET /api/cron/seo-engine-recovery — Authorization: Bearer CRON_SECRET (ingen x-vercel-cron bypass)
# Internal worker: POST /api/internal/seo-engine-article med x-internal-api-secret (= INTERNAL_API_SECRET)
# Deploy firestore.indexes.json før history / ordered queue recovery (status+updatedAt)
# Runbook: docs/seo-engine-runbook.md
# Type-check (strict feature-scope): npm run type-check:seo-engine

# Instagram / Facebook publish
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Påkrævet til «Konvertér token» under Indstillinger → Social og til «Kør diagnose»:
# 1) https://developers.facebook.com/apps/ → vælg jeres app (samme som i Graph API Explorer)
# 2) App settings → Basic → kopier «App ID» → META_APP_ID
# 3) «App secret» → Show → kopier → META_APP_SECRET (del den aldrig offentligt)
META_APP_ID=
META_APP_SECRET=

# Build/version label (shown in UI)
NEXT_PUBLIC_BUILD_LABEL=
NEXT_PUBLIC_BUILD_ID=

# Integrations
TMDB_API_KEY=
OMDB_API_KEY=
# Opret Programmable Search Engine på programmablesearchengine.google.com og aktiver
# "Custom Search API" i Google Cloud Console (APIs & Services → Library). Uden dette får du 403.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# API-gate (middleware) — påkrævet i Production. Browser sender Firebase ID-token; cron/scripts bruger CRON_SECRET eller denne header.
# Header: x-internal-api-secret: <værdi>  eller  Authorization: Bearer <værdi>
# Generér: openssl rand -hex 32
INTERNAL_API_SECRET=

# Cron / deploy — påkrævet for Vercel Cron (fx /api/cron/newsletter-scheduled planlagt nyhedsbrev). Værdi skal matche Authorization Bearer i cron-kald.
# Kun synlige ASCII-tegn (fx openssl rand -hex 32). Ingen æ/ø/å — Vercel fejler ellers ved deploy med «non-ASCII character in HTTP headers».
CRON_SECRET=
# Liv auto-artikler: default er draft i Webflow CMS (god til redaktionelt review).
# Sæt til "published" hvis cron skal publicere live med det samme.
LIV_DAILY_WEBFLOW_STATUS=draft
# Stående emne til morgen-cron når der ikke ligger en dagsplan med emne i Firestore. Ny artikel hver dag med fokus på dette (fx sommerfestival 2026).
# LIV_DAILY_DEFAULT_TOPIC_HINT=Festival sommeren 2026 i Danmark: programmer, steder, stemning, danske navne
# 0 = Liv må tage udgangspunkt uden match i /api/trending (nødvendig for rent redaktionelle emner som ovenfor). 1 = tving trending-match.
# LIV_DAILY_DEFAULT_MUST_USE_TRENDING=0
# AI-thumbnails (/api/generate-image) er som standard SLÅET FRA — sæt kun til 1 lokalt hvis du bevidst tester.
# AI_IMAGE_GENERATION_ENABLED=1
# Auto-fredag (/api/cron/newsletter-weekly): ekskluder artikel-id'er fra de seneste N vellykkede auto-sends (slækket runde bruger det mindre tal). Kræver Firestore-indeks — se firestore.indexes.json.
# NEWSLETTER_WEEKLY_EXCLUDE_SEND_LOOKBACK=16
# NEWSLETTER_WEEKLY_RELAX_SEND_LOOKBACK=4
# Auto-ugentlig tid/til-fra styres i Firestore: newsletterSettings/weeklyAuto (UI: Nyhedsbrev → Automatisk hver uge). Cron: /api/cron/newsletter-weekly hvert 15. min (vercel.json).
# Drift: Vercel Function Logs [cron/newsletter-weekly]; newsletterWeeklySends dokument-id auto-{år}-W{uge} (København-ISO-uge).
# Test auto-fredag uden e-mail/Firestore-claim: GET /api/cron/newsletter-weekly?dryRun=1 med header Authorization: Bearer $CRON_SECRET
# Valgfrit i dry run: &withAi=1 (ellers springes intro-AI over for hurtigere kald).
# Kun lokalt (NODE_ENV=development): NEWSLETTER_WEEKLY_BYPASS_TIME_GATE=true — hele flowet (claim+send) selv udenfor fredag≥12. Brug ikke på Vercel Production.
# Lokal cron-simulator: npm run dev:cron — kalder både /api/cron/newsletter-scheduled og /api/cron/newsletter-weekly (Bearer CRON_SECRET).
# NEWSLETTER_DEV_BASE_URL=http://localhost:3000
# NEWSLETTER_DEV_CRON_INTERVAL_MS=60000

# Nyhedsbrev (Resend) — brug kun i .env.local / Vercel, aldrig i git
RESEND_API_KEY=
# Valgfri — kun e-mail (fx noreply@…) får automatisk visningsnavn «Apropos Magazine»; eller sæt fuld streng: Navn <mail@domæne.dk>
RESEND_FROM_EMAIL=
# Funding Desk — separat afsender og inbound-domæne til svar (Resend Receiving + MX)
FUNDING_FROM_EMAIL=
FUNDING_INBOUND_DOMAIN=
# Modtagerliste: standard er Webflow-formular (Forms API). Native signup-formularer har IKKE CMS Collection ID.
# Nedenfor kun hvis I manuelt har en CMS-collection til e-mailtilmeldinger (sjældent). Tom = brug kun formular.
WEBFLOW_NEWSLETTER_SIGNUPS_COLLECTION_ID=
# Felt-slug for e-mail i den valgfrie CMS-collection (standard email)
WEBFLOW_SIGNUP_EMAIL_FIELD_SLUG=email
NEWSLETTER_ARTICLE_BASE_URL=https://www.aproposmagazine.com
# Base-URL for denne Next-app (HTTPS), så logo kan hentes fra /images/... i mail. Må ikke være samme origin som NEWSLETTER_ARTICLE_BASE_URL (Webflow har ikke filen) — så bruges indlejret logo.
NEXT_PUBLIC_BASE_URL=
# Vercel sætter automatisk VERCEL_URL; VERCEL_PROJECT_PRODUCTION_URL er produktions-hostname uden https:// (valgfri, bedre end preview-URL til logo).
# VERCEL_PROJECT_PRODUCTION_URL=
# Valgfri absolut PNG-URL (anbefalet hvis du vil hoste logo på magasin/CDN). Ellers: https-app-URL + /images/... eller indlejret PNG i mailen.
NEWSLETTER_LOGO_URL=
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Valgfri men anbefalet på Vercel: absolut HTTPS-URL til denne app (samme som NEXT_PUBLIC_BASE_URL hvis den kun peger på subscribe-domænet). Sikrer korrekt afmeld-link selv hvis NEXT_PUBLIC_* ikke er tilgængelig ved send.
# NEWSLETTER_UNSUBSCRIBE_BASE_URL=https://subscribe.aproposmagazine.com
# Webflow Forms API: form-id eller del af navn til auto-detect (kræver forms:read på site-token). Anbefalet for normale tilmeldinger.
# Frameldning sletter formular-svar via API — tilføj også forms:write på samme token.
WEBFLOW_NEWSLETTER_FORM_ID=
# Velkomstmail via webhook (standard: pause). Sæt true + secret når I er klar.
NEWSLETTER_WELCOME_WEBHOOK_ENABLED=false
NEWSLETTER_WEBHOOK_SECRET=
NEWSLETTER_WELCOME_SUBJECT=Velkommen til Apropos Magazine

# Liv Brandt auto-publish — komma-separerede tekstfragmenter; trending-kandidater hvis titlen indeholder et fragment (fx kanye west, trump).
# LIV_TOPIC_TITLE_BLOCKLIST=kanye west

# Google Analytics 4 — valgfri gtag på denne Next-app (pageviews på ai.*). UTM i nyhedsbrev giver sessioner på Webflow når deres site har GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Numerisk Property ID til dashboard / Data API (Admin → Property settings). Magasin: 484743571.
GA4_PROPERTY_ID=
# Google Search Console property for SEO Engine query/page signals (Search Analytics API).
# Examples: sc-domain:aproposmagazine.com  OR  https://www.aproposmagazine.com/
# Requires: Search Console API enabled on GCP + firebase-adminsdk email added as user on the GSC property.
# Note: GA4↔GSC product link alone does NOT grant the service account GSC API access.
GSC_SITE_URL=
# Measurement Protocol (server): samme property som G- ID. Opret API secret under Admin → Data streams → Measurement Protocol.
GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_PROTOCOL_SECRET=
# Data API: firebase-adminsdk@… skal have Viewer på property i GA4 Admin. Enable APIs: analyticsdata + analyticsadmin på GCP.
# Verificér: GET /api/ga4/status (Firebase-login). Tildel Viewer: node scripts/ga4-grant-viewer.mjs
# Resend → Webhooks → Signing secret (whsec_…). Endpoint: POST /api/webhooks/resend (vælg email.opened, email.clicked).
RESEND_WEBHOOK_SECRET=

# Stripe billing (Apropos Research self-serve)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Slå subscription-gate fra (bruges ikke — kun til fremtidig brug)
BILLING_DISABLED=true
# Komma-separerede Firebase UID'er der springer billing over (interne brugere i prod)
BILLING_BYPASS_UIDS=

# Podcast Upload — browser uploader direkte til Firebase Storage; behandling kører på Cloud Run.
# PODCAST_PROCESSOR_URL=https://podcast-processor-xxxxx.run.app
# PODCAST_NOTIFY_URL=https://us-central1-PROJECT.cloudfunctions.net/sendPodcastNotification
# PODCAST_NOTIFY_SECRET=   # samme værdi som firebase functions:secrets:set PODCAST_NOTIFY_SECRET (iOS-projekt)
# Header: X-Apropos-Podcast-Secret
# PODCAST_STORAGE_BUCKET=   # valgfri; fallback NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
