rules_version = '2';

// Deploy: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /apropos-config/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /instagram-publish/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Indloggede brugere må lægge rå podcast-filer i incoming (browser-upload).
    // Størrelse valideres server-side i /api/podcast/upload-url.
    match /podcasts/incoming/{slug}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Publicerede episoder og manifest håndteres af Admin SDK / Cloud Run.
    match /podcasts/articles/{slug}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /podcasts/manifest.json {
      allow read: if true;
      allow write: if false;
    }
  }
}
