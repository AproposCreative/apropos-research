{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/daily-ingest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/newsletter-weekly",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/newsletter-scheduled",
      "schedule": "*/15 * * * *"
    }
  ]
}
